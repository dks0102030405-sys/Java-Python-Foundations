import java.util.*;

public class Fibonacci {
    public static void main(String args[]) {
        Scanner ob = new Scanner(System.in);
        System.out.print("Enter the last term limit: ");
        int n = ob.nextInt();
        
        int a = 0;
        int b = 1;
        
        System.out.print("Fibonacci Series: ");
      
        while (a <= n) {
            System.out.print(a + ", ");
            int c = a + b;
            a = b;
            b = c;
        }
    }
}
