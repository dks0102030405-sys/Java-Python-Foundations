p = 0
a = int(input("Enter an atomic number: "))

if a >= 5 and a <= 10:
    p = a - 4
elif a >= 13 and a <= 18:
    p = a - 12
else:
    p = -1 
    print("Element not found in Period 2 and 3.")


if p == 3:
    print("It is half filled")
elif p == 4:
    print("It has a pairing penalty")
elif p != -1:
    print("Standard configuration (not p3 or p4).")
